# ---------- Core ----------
NODE_ENV=development
PORT=8000
# MongoDB connection string (Atlas: Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/meethive

# Comma separated frontend origins allowed to call the API (REQUIRED in production)
# e.g. CORS_ORIGINS=https://meethivefrontend.onrender.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

TOKEN_TTL_DAYS=7
MAX_ROOM_SIZE=12

# ---------- TURN (required for calls across different networks / mobile data) ----------
# Pick ONE of the options below.

# Option C (easiest): Metered.ca - free tier, create an app at https://dashboard.metered.ca
# METERED_DOMAIN=yourapp.metered.live
# METERED_API_KEY=your_api_key

# Option A: static credentials from any TURN provider (Metered, Twilio, Xirsys, ExpressTURN, own coturn)
# TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Option B: self-hosted coturn with `use-auth-secret` + `static-auth-secret=<TURN_SECRET>`
# TURN_URLS=turn:turn.yourdomain.com:3478,turns:turn.yourdomain.com:5349?transport=tcp
# TURN_SECRET=
# TURN_TTL_SECONDS=21600

# Optional: override STUN servers
# STUN_URLS=stun:stun.l.google.com:19302
